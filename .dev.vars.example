# Copy to .dev.vars for `npm run dev:worker`. Never commit .dev.vars.

# Cloudflare Email Sending. The API token needs Email Sending: Edit permission.
CLOUDFLARE_API_TOKEN=

# Optional locally because wrangler.toml supplies the account ID.
CLOUDFLARE_ACCOUNT_ID=fdabb6996edf7688fdaf7c8c367f7d08

# Optional sender override. It must belong to a connected and verified Email
# Sending domain. Leave blank to use the default in worker/contact.ts.
EMAIL_FROM_CONTACT=

# Optional override for the inbox that receives form messages. Leave blank to
# use the default in worker/contact.ts.
CONTACT_TO_EMAIL=

# Server-side secret for the Turnstile widget. For local testing use
# Cloudflare's always-passes test secret (it pairs with the test site key the
# dev build uses): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Local-only overrides of the strict production checks in wrangler.toml [vars].
# `npm run dev:worker` serves the page from http://localhost:8787, and
# Cloudflare's Turnstile test keys report hostname "example.com" and no action.
# Keep these in .dev.vars only; production uses the wrangler.toml values.
ALLOWED_ORIGIN=http://localhost:8787
TURNSTILE_HOSTNAME=example.com
# Empty skips the action check (test keys return no action).
TURNSTILE_ACTION=
