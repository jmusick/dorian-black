# Copy to .dev.vars for `npm run dev:worker`. Never commit .dev.vars.

# Cloudflare Email Sending. The API token needs Email Sending: Edit permission.
CLOUDFLARE_API_TOKEN=

# Optional locally because wrangler.toml supplies the account ID.
CLOUDFLARE_ACCOUNT_ID=fdabb6996edf7688fdaf7c8c367f7d08

# Optional sender override. It must belong to a connected and verified Email
# Sending domain. Leave blank to use the default in worker/contact.ts.
EMAIL_FROM_CONTACT=

# Optional override for the inbox that receives form messages. Leave blank to
# use the default in worker/contact.ts.
CONTACT_TO_EMAIL=

# Server-side secret for the Turnstile widget whose public key is provided at
# build time through PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
