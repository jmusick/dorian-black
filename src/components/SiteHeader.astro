---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo-transparent.png";
import { ACTIVE_SOCIALS, SITE_NAME } from "../config/site";

interface Props {
	active?: "home" | "music" | "about" | "contact";
}

const { active = "home" } = Astro.props;
---

<header class="site-head">
	<div class="site-head-inner">
		<a href="/" class="brand-link" aria-label={`${SITE_NAME} — home`}>
			<Image class="brand-logo" src={logo} alt={SITE_NAME} widths={[220, 440]} loading="eager" />
		</a>

		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Toggle menu"
		>
			<Icon name="lucide:menu" class="nav-toggle-icon-open" aria-hidden="true" />
			<Icon name="lucide:x" class="nav-toggle-icon-close" aria-hidden="true" />
		</button>

		<div class="site-head-right" id="site-menu">
			<nav class="site-nav" aria-label="Primary">
				<a class={active === "home" ? "active" : undefined} aria-current={active === "home" ? "page" : undefined} href="/">Home</a>
				<a class={active === "music" ? "active" : undefined} aria-current={active === "music" ? "page" : undefined} href="/music/">Music</a>
				<a class={active === "about" ? "active" : undefined} aria-current={active === "about" ? "page" : undefined} href="/about/">About</a>
				<a class={active === "contact" ? "active" : undefined} aria-current={active === "contact" ? "page" : undefined} href="/contact/">Contact</a>
			</nav>

			{ACTIVE_SOCIALS.length > 0 && (
				<>
					<div class="site-head-divider" aria-hidden="true"></div>
					<nav class="social-nav" aria-label="Social media, header">
						{ACTIVE_SOCIALS.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.label}
								class="social-link"
							>
								<Icon name={s.icon} aria-hidden="true" />
							</a>
						))}
					</nav>
				</>
			)}
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const menu = document.getElementById("site-menu");

	if (toggle && menu) {
		const setOpen = (isOpen: boolean) => {
			menu.classList.toggle("is-open", isOpen);
			toggle.classList.toggle("is-open", isOpen);
			toggle.setAttribute("aria-expanded", String(isOpen));
		};

		toggle.addEventListener("click", () => setOpen(!menu.classList.contains("is-open")));

		menu.addEventListener("click", (event) => {
			if (event.target instanceof HTMLElement && event.target.closest("a")) {
				const wasOpen = menu.classList.contains("is-open");
				setOpen(false);
				// The menu is about to be hidden; keep focus on something visible
				// (matters for same-page links that do not trigger a navigation).
				if (wasOpen && toggle.offsetParent !== null) toggle.focus();
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menu.classList.contains("is-open")) {
				setOpen(false);
				toggle.focus();
			}
		});
	}
</script>
