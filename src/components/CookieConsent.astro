---
/**
 * Cookie consent banner for Google Analytics and the home page's Spotify player.
 *
 * Opt-in, and strictly so: gtag.js is not fetched at all until the visitor
 * accepts. A banner that loads the tag first and asks second still discloses the
 * visitor's IP to Google on page one, which is the thing consent is supposed to
 * prevent — so the script element is created only in the accept path.
 *
 * The choice lives in localStorage, not a cookie, so recording "no" doesn't
 * itself store anything a consent regime would object to.
 *
 * The choice is also published for other scripts: `data-consent="granted"` on
 * <html> once consent is given (stored or just now), plus a `db:consent` event
 * carrying the choice. The home page loads its Spotify player from these.
 *
 * `measurementId` is null in dev (see ANALYTICS_ID in src/config/site.ts): the
 * banner still renders and behaves normally, it just has nothing to load.
 */
interface Props {
	measurementId: string | null;
}

const { measurementId } = Astro.props;
---

<div
	id="cookie-consent"
	class="cookie-consent"
	role="region"
	aria-label="Cookie consent"
	hidden
>
	<div class="cc-inner">
		<div class="cc-text">
			<p class="cc-title">Cookies</p>
			<p class="cc-body">
				This site would like to count visits with Google Analytics and load the Spotify
				player on the home page, both of which set cookies. Nothing is sent to Google or
				Spotify unless you accept; if you decline, the player still loads with one click.
				See the <a href="/privacy-policy/">privacy policy</a>.
			</p>
		</div>
		<div class="cc-actions">
			<button type="button" class="btn btn-ghost btn-sm" data-consent="denied">Decline</button>
			<button type="button" class="btn btn-primary btn-sm" data-consent="granted">Accept</button>
		</div>
	</div>
</div>

<script is:inline define:vars={{ measurementId }}>
	(function () {
		var STORAGE_KEY = "db-analytics-consent";
		var banner = document.getElementById("cookie-consent");
		if (!banner) return;

		var stored = null;
		try {
			stored = localStorage.getItem(STORAGE_KEY);
		} catch (e) {
			// Private-browsing modes can throw on access; treat as "no choice yet".
		}

		window.dataLayer = window.dataLayer || [];
		function gtag() {
			dataLayer.push(arguments);
		}

		var loaded = false;
		function loadAnalytics() {
			if (loaded || !measurementId) return;
			loaded = true;

			// Consent Mode defaults are declared before config so the tag never
			// assumes permission for anything beyond the analytics storage granted here.
			gtag("consent", "default", {
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
				analytics_storage: "denied",
			});
			gtag("consent", "update", { analytics_storage: "granted" });
			gtag("js", new Date());
			gtag("config", measurementId);

			var script = document.createElement("script");
			script.async = true;
			script.src = "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
			document.head.appendChild(script);
		}

		/** Withdrawing consent can't unload a running tag — drop its cookies and reload. */
		function clearAnalyticsCookies() {
			var host = location.hostname;
			document.cookie.split(";").forEach(function (entry) {
				var name = entry.split("=")[0].trim();
				if (name.indexOf("_ga") !== 0) return;
				var expiry = "=; Max-Age=0; path=/";
				document.cookie = name + expiry;
				document.cookie = name + expiry + "; domain=" + host;
				document.cookie = name + expiry + "; domain=." + host;
			});
		}

		var root = document.documentElement;
		var opener = null; // element that reopened the banner, if any
		var reopened = false;

		/** Keep the banner from covering page content: pad the page by its height. */
		function syncOffset() {
			if (banner.hidden) {
				root.style.removeProperty("--cc-offset");
				return;
			}
			var gap = parseFloat(getComputedStyle(banner).bottom) || 0;
			root.style.setProperty("--cc-offset", banner.offsetHeight + gap + "px");
		}
		if (window.ResizeObserver) new ResizeObserver(syncOffset).observe(banner);

		function show() {
			banner.hidden = false;
			syncOffset();
		}

		/** Hide the banner and keep focus somewhere sensible instead of dropping to <body>. */
		function dismiss() {
			var hadFocus = banner.contains(document.activeElement);
			banner.hidden = true;
			syncOffset();
			reopened = false;
			if (!hadFocus) return;
			var target = opener && opener.isConnected ? opener : document.getElementById("main");
			opener = null;
			if (!target) return;
			if (target.id === "main") target.setAttribute("tabindex", "-1");
			target.focus();
		}

		/** Let other scripts (the Spotify player) act on consent without reading storage. */
		function announce(choice) {
			if (choice === "granted") root.setAttribute("data-consent", "granted");
			document.dispatchEvent(new CustomEvent("db:consent", { detail: choice }));
		}

		function record(choice) {
			var wasGranted = stored === "granted";
			stored = choice;
			try {
				localStorage.setItem(STORAGE_KEY, choice);
			} catch (e) {
				// Choice won't persist, but honour it for this page view.
			}
			dismiss();
			announce(choice);

			if (choice === "granted") {
				loadAnalytics();
			} else if (wasGranted) {
				clearAnalyticsCookies();
				location.reload();
			}
		}

		if (stored === "granted") {
			announce("granted");
			loadAnalytics();
		} else if (stored !== "denied") {
			show();
		}

		banner.addEventListener("click", function (event) {
			var button = event.target.closest("[data-consent]");
			if (button) record(button.getAttribute("data-consent"));
		});

		// Any element with data-cookie-preferences reopens the choice — the footer
		// link uses this, and it satisfies "consent must be as easy to withdraw".
		document.addEventListener("click", function (event) {
			var trigger = event.target.closest("[data-cookie-preferences]");
			if (!trigger) return;
			event.preventDefault();
			opener = trigger;
			reopened = true;
			show();
			banner.querySelector("[data-consent]").focus();
		});

		// Escape closes the banner when it was reopened from the footer; it records
		// nothing, so the earlier choice stands.
		document.addEventListener("keydown", function (event) {
			if (event.key === "Escape" && reopened && !banner.hidden) dismiss();
		});
	})();
</script>

<style>
	.cookie-consent {
		position: fixed;
		z-index: 60;
		left: var(--space-4);
		right: var(--space-4);
		bottom: var(--space-4);
		background: var(--bg-surface-raised);
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-md);
		box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
		padding: var(--space-4) var(--space-5);
	}

	.cookie-consent[hidden] {
		display: none;
	}

	.cc-inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: var(--space-5);
		flex-wrap: wrap;
	}

	.cc-text {
		flex: 1 1 340px;
	}

	.cc-title {
		font-family: var(--font-display);
		font-size: var(--text-body);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--text-primary);
		margin: 0 0 var(--space-1) 0;
	}

	.cc-body {
		font-family: var(--font-body);
		font-size: var(--text-body-sm);
		line-height: 1.55;
		color: var(--text-secondary);
		margin: 0;
	}

	.cc-body a {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.cc-actions {
		display: flex;
		gap: var(--space-3);
		flex-shrink: 0;
	}

	@media (max-width: 640px) {
		.cc-actions {
			width: 100%;
		}

		.cc-actions .btn {
			flex: 1;
		}
	}
</style>
