---
import { Icon } from "astro-icon/components";
import { ACTIVE_SOCIALS, GA_MEASUREMENT_ID, SITE_NAME, SITE_VERSION } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span class="footer-mark">{SITE_NAME}</span>

	{ACTIVE_SOCIALS.length > 0 && (
		<nav class="social-nav" aria-label="Social media, footer">
			{ACTIVE_SOCIALS.map((s) => (
				<a
					href={s.href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={s.label}
					class="social-link"
				>
					<Icon name={s.icon} aria-hidden="true" />
				</a>
			))}
		</nav>
	)}

	<div class="footer-legal">
		<span>© {year} {SITE_NAME} · v{SITE_VERSION} · <a href="/privacy-policy/">Privacy Policy</a>{GA_MEASUREMENT_ID && (
			<>
				{" · "}
				{/* Reopens the consent banner — see src/components/CookieConsent.astro. */}
				<button type="button" class="footer-link-button" data-cookie-preferences>Cookie choices</button>
			</>
		)}</span>
		<span class="footer-credit">Site design by <a href="https://stonedragonmedia.com/" target="_blank" rel="noopener noreferrer">Stone Dragon Media, LLC</a></span>
	</div>
</footer>
