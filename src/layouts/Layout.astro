---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { ANALYTICS_ID, GA_MEASUREMENT_ID, SITE_NAME, SITE_URL } from "../config/site";
import { ALBUM } from "../data/album";
import { buildSchemaGraph } from "../lib/schema";

interface Props {
	title: string;
	description: string;
	canonicalUrl: string;
	socialImageUrl?: string;
	socialImageAlt?: string;
	ogType?: string;
	robots?: string;
	/** Defaults to the site-wide graph (WebSite + artist) from src/lib/schema.ts. */
	structuredData?: Record<string, unknown>;
	active?: "home" | "music" | "about" | "contact";
}

const {
	title,
	description,
	canonicalUrl,
	socialImageUrl = `${SITE_URL}/og.png`,
	socialImageAlt = `${SITE_NAME} logo beside the ${ALBUM.title} album cover`,
	ogType = "website",
	robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
	structuredData = await buildSchemaGraph(),
	active,
} = Astro.props;

/** Escape "<" so the JSON can never close its script element early. */
const jsonLd = JSON.stringify(structuredData).replace(/</g, "\\u003c");

/**
 * The banner renders wherever analytics is configured at all, so it stays
 * workable in dev; ANALYTICS_ID is what decides whether accepting actually
 * loads anything, and that is production-only.
 */
const showConsentBanner = GA_MEASUREMENT_ID !== null;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link
			rel="preload"
			href="/fonts/audiowide-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="stylesheet" href="/universal.css" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={SITE_NAME} />
		<meta name="theme-color" content="#04000a" />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={socialImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@dorianblackband" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content={socialImageAlt} />
		<script type="application/ld+json" set:html={jsonLd}></script>
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		{showConsentBanner && <CookieConsent measurementId={ANALYTICS_ID} />}
		<SiteHeader active={active} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
