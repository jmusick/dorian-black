---
import Layout from "../layouts/Layout.astro";
import { AFTER_TONIGHT, LATEST, formatReleaseDate, isReleased } from "../data/album";
import { ACTIVE_SOCIALS, META_DESCRIPTIONS, SITE_NAME, SITE_URL, SOCIAL_REL, socialLabel } from "../config/site";

const canonicalUrl = `${SITE_URL}/about/`;

/**
 * Placeholder bio, written in third person but not approved copy.
 * Replace before launch.
 */
const bio = [
	`${SITE_NAME} makes synth-pop for the hours most records sleep through — the stretch between last call and first light, when a city is at its loudest and its loneliest at the same time.`,
	`The debut album, ${AFTER_TONIGHT.title}, runs ${AFTER_TONIGHT.tracks.length} tracks across a single night: the doors opening, the look across the room, the walk home, and the morning that doesn't care what happened.`,
	`${LATEST.title}, ${isReleased(LATEST) ? "the second album" : `the second album, out ${formatReleaseDate(LATEST)}`}, follows what happens once the night turns into a life: kitchen dances, late phone calls, and the person who saves you a seat.`,
	`Neon synths, close vocals, and a drum machine that never quite lets up.`,
];
---

<Layout
	title={`About ${SITE_NAME} — Synth-Pop Artist`}
	description={META_DESCRIPTIONS.about}
	canonicalUrl={canonicalUrl}
	active="about"
>
	<div class="page">
		<p class="eyebrow">About</p>
		<h1 style="margin-top: var(--space-3)">{SITE_NAME}</h1>

		<div
			class="panel"
			style="margin-top: var(--space-7); display: flex; flex-direction: column; gap: var(--space-5)"
		>
			{bio.map((paragraph) => <p class="lede">{paragraph}</p>)}
		</div>

		<hr class="rule" />

		<section>
			<p class="eyebrow">Contact</p>
			<h2 style="margin-top: var(--space-3)">Bookings &amp; press</h2>
			<p class="lede" style="margin-top: var(--space-4)">
				For booking, press, licensing, collaborations, and other enquiries, use the
				contact form.
			</p>
			<div class="hero-cta">
				<a class="btn btn-secondary" href="/contact/">Get in touch</a>
			</div>
		</section>

		{ACTIVE_SOCIALS.length > 0 && (
			<section class="section">
				<h2 class="eyebrow">Elsewhere</h2>
				<div class="hero-cta" style="margin-top: var(--space-4)">
					{ACTIVE_SOCIALS.map((s) => (
						<a class="btn btn-ghost" href={s.href} target="_blank" rel={SOCIAL_REL} aria-label={socialLabel(s)}>
							{s.label}
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>
