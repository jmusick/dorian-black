---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import cover from "../assets/after-tonight-cover.png";
import { ALBUM, ALBUM_RUNTIME, TRACK_COUNT } from "../data/album";
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from "../config/site";

const canonicalUrl = `${SITE_URL}/`;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "MusicGroup",
	name: SITE_NAME,
	url: SITE_URL,
	genre: "Synth-pop",
	description: SITE_TAGLINE,
	album: {
		"@type": "MusicAlbum",
		name: ALBUM.title,
		numTracks: TRACK_COUNT,
		byArtist: { "@type": "MusicGroup", name: SITE_NAME },
	},
};

const spotifyAlbumId = ALBUM.spotifyUrl.match(/open\.spotify\.com\/album\/([A-Za-z0-9]+)/)?.[1];
const spotifyEmbedUrl = `https://open.spotify.com/embed/album/${spotifyAlbumId}?utm_source=generator&theme=0`;
const spotifyEmbedHeight = Math.min(760, Math.max(352, 170 + ALBUM.tracks.length * 34));
---

<Layout
	title={`${SITE_NAME} — ${ALBUM.title}`}
	description={ALBUM.blurb}
	canonicalUrl={canonicalUrl}
	structuredData={structuredData}
	active="home"
>
	<section class="hero">
		<Image class="hero-art" src={cover} alt="" widths={[900, 1600]} loading="eager" />
		<div class="hero-scrim" aria-hidden="true"></div>

		<div class="hero-inner">
			<span class="badge badge-filled">{ALBUM.kind} · {ALBUM.status}</span>
			<h1 class="hero-title">{ALBUM.title}</h1>
			<p class="hero-sub">{ALBUM.blurb}</p>
			<div class="hero-cta">
				<a class="btn btn-primary btn-lg" href="/music/">Hear the album</a>
				<a class="btn btn-secondary btn-lg" href="/about/">About Dorian Black</a>
			</div>
		</div>
	</section>

	<div class="page">
		<section>
			<h2 class="eyebrow">The record</h2>
			<p class="stat-line">{TRACK_COUNT} tracks · {ALBUM_RUNTIME}</p>
			<p class="lede" style="margin-top: var(--space-4)">{SITE_TAGLINE}</p>
		</section>

		<section class="section">
			<h2 class="eyebrow">Listen now</h2>
			<div class="spotify-embed" style={`height: ${spotifyEmbedHeight}px`} data-spotify-embed>
				<button type="button" class="spotify-facade" data-spotify-load>
					<span class="spotify-facade-title">Load the Spotify player</span>
					<span class="spotify-facade-note">
						Nothing is requested from Spotify until you click.
					</span>
				</button>
				<template data-spotify-template>
					<iframe
						src={spotifyEmbedUrl}
						width="100%"
						height={spotifyEmbedHeight}
						frameborder="0"
						allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
						title={`${ALBUM.title} on Spotify`}></iframe>
				</template>
				<noscript>
					<p class="spotify-noscript">
						<a href={ALBUM.spotifyUrl} target="_blank" rel="noopener noreferrer">
							Listen to {ALBUM.title} on Spotify
						</a>
					</p>
				</noscript>
			</div>
		</section>
	</div>
</Layout>

<script>
	const embed = document.querySelector<HTMLElement>("[data-spotify-embed]");
	const button = embed?.querySelector<HTMLButtonElement>("[data-spotify-load]");
	const template = embed?.querySelector<HTMLTemplateElement>("[data-spotify-template]");

	button?.addEventListener("click", () => {
		const iframe = template?.content.querySelector("iframe")?.cloneNode(true);
		if (!(iframe instanceof HTMLIFrameElement) || !embed || !button) return;
		button.replaceWith(iframe);
		iframe.focus();
	});
</script>

<style>
	.page {
		padding-bottom: var(--space-7);
	}

	.section {
		margin-top: var(--space-6);
	}

	.spotify-embed {
		margin-top: var(--space-5);
		border: 1px solid var(--border-hairline);
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--bg-surface);
	}

	.spotify-embed :global(iframe) {
		display: block;
		border: 0;
	}

	.spotify-facade {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		width: 100%;
		height: 100%;
		padding: var(--space-4);
		border: 0;
		background: var(--surface);
		color: var(--ink-1);
		font-family: var(--font-body);
		text-align: center;
		cursor: pointer;
	}

	.spotify-facade:hover {
		background: var(--surface-2);
	}

	.spotify-facade-title {
		font-family: var(--font-display);
		font-size: var(--text-h3);
		color: var(--cyan);
	}

	.spotify-facade-note {
		font-size: var(--text-body-sm);
		color: var(--ink-2);
	}

	.spotify-noscript {
		padding: var(--space-4);
	}
</style>
