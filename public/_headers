# Security headers for every static asset (Workers Static Assets). Responses
# built by the Worker (/api/contact) set their own in worker/contact.ts.
#
# CSP_SCRIPT_HASHES is replaced at build time with the sha256 of every inline
# <script> in dist/ (src/integrations/csp-headers.mjs). Any new third-party
# origin needs an entry here, plus the privacy policy (see AGENTS.md).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=(), autoplay=(self "https://open.spotify.com"), encrypted-media=(self "https://open.spotify.com"), fullscreen=(self "https://open.spotify.com"), picture-in-picture=(self "https://open.spotify.com"), clipboard-write=(self "https://open.spotify.com")
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://www.googletagmanager.com CSP_SCRIPT_HASHES; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com https://open.spotify.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Hashed build output never changes under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed-URL files (fonts, icons, share image, manifest) can change in place, so
# cache them for a day and refresh in the background for up to a week after.
# HTML, robots.txt and the sitemap keep the platform default (max-age=0,
# must-revalidate). Cloudflare merges every matching rule, so these paths
# still get the security headers from /* above.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
